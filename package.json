{
  "name": "n8n-nodes-soniox-api",
  "version": "0.8.1",
  "description": "n8n node for Soniox Speech-to-Text API",
  "main": "index.js",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lintfix": "n8n-node lint --fix",
    "lint:fix": "n8n-node lint --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run",
    "check": "npm run lint && npm test && npm run build && npm run pack:check",
    "prepublishOnly": "npm run check"
  },
  "files": [
    "dist",
    "index.js"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/SonioxApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Soniox/Soniox.node.js"
    ]
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "soniox",
    "speech-to-text",
    "transcription",
    "audio",
    "voice-recognition",
    "stt",
    "asr",
    "workflow-automation"
  ],
  "license": "MIT",
  "homepage": "https://github.com/mazixs/n8n-nodes-soniox-api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mazixs/n8n-nodes-soniox-api.git"
  },
  "bugs": {
    "url": "https://github.com/mazixs/n8n-nodes-soniox-api/issues"
  },
  "author": {
    "name": "mazix",
    "email": "mazix@bk.ru"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.43.4",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "4.1.10",
    "n8n-workflow": "2.16.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
